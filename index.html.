<!DOCTYPE html>
<html lang="uk">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Grizzly — барбершоп</title>
<style>
:root{--bg:#0e0e0e;--card:#171717;--line:#262626;--text:#f1efea;--muted:#8d8a84;--y:#f2c94c;--y2:#e0b43a;color-scheme:dark;
box-sizing:border-box;padding-bottom:env(safe-area-inset-bottom,0px)}
*{box-sizing:border-box}
[hidden]{display:none!important}
html{scroll-behavior:smooth;scroll-padding-top:90px}
body{margin:0;background:var(--bg);color:var(--text);font:16px/1.55 system-ui,-apple-system,"Segoe UI",Roboto,Arial,sans-serif}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);background:var(--bg);z-index:40}
a{color:inherit}
.wrap{max-width:960px;margin:0 auto;padding:0 20px}
header{position:sticky;top:env(safe-area-inset-top,0px);z-index:30;background:rgba(14,14,14,.92);backdrop-filter:blur(8px);box-shadow:0 8px 24px rgba(0,0,0,.45)}
header .wrap{display:flex;align-items:center;justify-content:space-between;gap:16px;height:72px}
nav{display:flex;gap:2px;align-items:center;overflow-x:auto;scrollbar-width:none;min-width:0}
nav::-webkit-scrollbar{display:none}
nav a,nav .city{white-space:nowrap;text-decoration:none;font:inherit;font-size:12px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);padding:10px 12px;transition:color .2s;background:none;border:0;cursor:pointer}
nav a:hover,nav .city:hover{color:var(--text)}
.city svg{width:10px;height:10px;margin-left:6px;transition:transform .25s}
.city.on svg{transform:rotate(180deg)}
.pill{background:var(--y);color:#16130a;border:0;border-radius:999px;font:inherit;font-size:12px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;padding:10px 18px;cursor:pointer;box-shadow:0 6px 18px rgba(242,201,76,.25);transition:transform .2s,box-shadow .2s;white-space:nowrap}
.pill:hover{transform:translateY(-2px);box-shadow:0 10px 24px rgba(242,201,76,.35)}
.logo{display:flex;align-items:center;gap:10px;text-decoration:none;flex-shrink:0}
.logo svg{width:48px;height:48px}
.logo .t{display:flex;flex-direction:column;line-height:1}
.logo small{font-size:8px;letter-spacing:.38em;color:var(--muted);margin-bottom:4px}
.logo b{font-size:19px;letter-spacing:.2em}
#cm{position:fixed;z-index:50;min-width:230px;background:var(--card);border-radius:14px;padding:6px;box-shadow:0 20px 50px rgba(0,0,0,.7);animation:pop .2s ease}
#cm button{display:block;width:100%;text-align:left;background:none;border:0;color:var(--text);font:inherit;padding:10px 12px;border-radius:10px;cursor:pointer}
#cm button:hover{background:#222}
#cm small{display:block;color:var(--muted)}
.hero{min-height:calc(100svh - 72px);display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:40px 0}
.hero h1{margin:0 0 16px;font-size:clamp(36px,8vw,68px);line-height:1.05;font-weight:700;letter-spacing:-.01em}
.hero p{margin:0 0 44px;color:var(--muted);font-size:clamp(16px,2.4vw,21px);font-style:italic}
.round{position:relative;width:150px;height:150px;border-radius:50%;border:0;background:radial-gradient(circle at 30% 25%,#ffe08a,var(--y) 55%,var(--y2));color:#16130a;font:inherit;font-weight:800;font-size:17px;cursor:pointer;box-shadow:0 14px 40px rgba(242,201,76,.28),inset 0 -6px 14px rgba(0,0,0,.12);transition:transform .25s,box-shadow .25s}
.round:hover{transform:scale(1.06);box-shadow:0 20px 54px rgba(242,201,76,.4)}
.round::after{content:"";position:absolute;inset:-10px;border-radius:50%;border:2px solid var(--y);opacity:0;animation:ring 2.4s ease-out infinite}
@keyframes ring{0%{transform:scale(.92);opacity:.6}100%{transform:scale(1.25);opacity:0}}
#fab{position:fixed;right:18px;bottom:calc(84px + env(safe-area-inset-bottom,0px));z-index:35;width:86px;height:86px;font-size:13px;line-height:1.15;opacity:0;transform:scale(.4);pointer-events:none;transition:opacity .4s,transform .4s}
#fab.show{opacity:1;transform:none;pointer-events:auto}
#fab.show:hover{transform:scale(1.08)}
#fab::after{inset:-6px}
section{padding:64px 0;scroll-margin-top:90px}
h2{margin:0 0 18px;font-size:13px;letter-spacing:.2em;text-transform:uppercase;color:var(--y);font-weight:600}
#foto{padding-top:120px;padding-bottom:120px}
.photos{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
.ph{aspect-ratio:4/5;border-radius:16px;display:flex;align-items:flex-end;padding:16px;color:var(--muted);font-size:13px;background:linear-gradient(160deg,#242424,#141414);box-shadow:0 18px 40px rgba(0,0,0,.55)}
.rise{opacity:0;transform:translateY(200px) scale(.92);transition:opacity 1.2s ease,transform 1.3s cubic-bezier(.16,.9,.25,1)}
.rise.in{opacity:1;transform:none}
.rise:nth-child(2){transition-delay:.15s}
.rise:nth-child(3){transition-delay:.3s}
.rv{opacity:0;transform:translateY(40px);filter:blur(6px);transition:opacity .9s ease,transform .9s ease,filter .9s ease}
.rv.in{opacity:1;transform:none;filter:none}
.card{background:var(--card);border-radius:16px;box-shadow:0 14px 34px rgba(0,0,0,.45)}
table{width:100%;border-collapse:collapse}
td{padding:15px 20px;border-bottom:1px solid var(--line)}
tr:last-child td{border-bottom:0}
td:last-child{text-align:right;font-weight:600;white-space:nowrap}
.row{display:flex;justify-content:space-between;gap:12px;padding:16px 20px;border-bottom:1px solid var(--line)}
.row:last-child{border-bottom:0}
.row small{display:block;color:var(--muted)}
.price{font-weight:700;white-space:nowrap;color:var(--y)}
.masters,.vals{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
.m{padding:22px;text-align:center;transition:transform .3s,box-shadow .3s}
.m:hover{transform:translateY(-5px);box-shadow:0 22px 44px rgba(0,0,0,.6)}
.av{width:84px;height:84px;border-radius:50%;margin:0 auto 12px;background:linear-gradient(160deg,#2c2c2c,#181818);box-shadow:0 8px 20px rgba(0,0,0,.5)}
.m b{display:block}
.m span{display:block;color:var(--muted);font-size:14px}
.note{color:var(--muted);font-size:14px;margin:14px 0 0}
.info{padding:20px}
.info p{margin:0 0 6px}
.info a{text-decoration:none;border-bottom:1px solid var(--y)}
.cols{display:grid;grid-template-columns:1fr 1fr;gap:16px}
.about-h{padding:110px 0 40px;text-align:center}
.about-h h1{margin:0 0 18px;font-size:clamp(40px,9vw,84px);line-height:1;animation:up 1s ease both}
.about-h p{margin:0 auto;max-width:560px;color:var(--muted);font-size:clamp(16px,2.4vw,20px);animation:up 1s .2s ease both}
@keyframes up{from{opacity:0;transform:translateY(40px)}to{opacity:1;transform:none}}
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;text-align:center}
.stats div{padding:28px 10px}
.stats b{display:block;font-size:clamp(32px,6vw,52px);color:var(--y)}
.stats span{color:var(--muted);font-size:14px}
.vals .card{padding:26px}
.vals h3{margin:0 0 8px;font-size:18px}
.vals p{margin:0;color:var(--muted);font-size:15px}
.center{text-align:center}
footer{padding:32px 0 44px;color:var(--muted);font-size:13px;margin-top:24px}
#ov{position:fixed;inset:0;z-index:60;background:rgba(0,0,0,.7);backdrop-filter:blur(4px);display:none;align-items:center;justify-content:center;padding:20px}
#ov.on{display:flex}
.modal{position:relative;background:var(--card);border-radius:20px;padding:34px 30px;text-align:center;max-width:340px;width:100%;box-shadow:0 30px 80px rgba(0,0,0,.8);animation:pop .3s ease}
@keyframes pop{from{opacity:0;transform:translateY(16px) scale(.95)}to{opacity:1;transform:none}}
.modal p{margin:0 0 8px;color:var(--muted)}
.modal .num{display:block;font-size:26px;font-weight:700;color:var(--y);text-decoration:none;margin:6px 0 20px}
.x{position:absolute;top:10px;right:14px;background:none;border:0;color:var(--muted);font-size:26px;cursor:pointer}
@media(max-width:640px){.photos,.masters,.vals,.cols{grid-template-columns:1fr}.ph{aspect-ratio:16/10}header .wrap{height:64px}.hero{min-height:calc(100svh - 64px)}.stats{gap:6px}}
@media(prefers-reduced-motion:reduce){.rv,.rise{opacity:1;transform:none;filter:none;transition:none}.round::after{animation:none}.about-h h1,.about-h p{animation:none}html{scroll-behavior:auto}}
</style>
</head>
<body>
