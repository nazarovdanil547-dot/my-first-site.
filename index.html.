<script>
(function(){
var $=function(s){return document.querySelector(s)};
var ov=$('#ov'),cm=$('#cm'),cb=$('#cb'),fab=$('#fab'),home=$('#v-home'),about=$('#v-about');
function open(){ov.classList.add('on')}
function close(){ov.classList.remove('on')}
document.querySelectorAll('[data-open]').forEach(function(b){b.addEventListener('click',open)});
ov.addEventListener('click',function(e){if(e.target===ov||e.target.className==='x')close()});
function closeCity(){cm.hidden=true;cb.classList.remove('on')}
document.addEventListener('keydown',function(e){if(e.key==='Escape'){close();closeCity()}});
cb.addEventListener('click',function(e){
e.stopPropagation();
if(!cm.hidden){closeCity();return}
var r=cb.getBoundingClientRect();
cm.hidden=false;
cm.style.top=(r.bottom+8)+'px';
cm.style.left=Math.max(12,Math.min(r.left,window.innerWidth-cm.offsetWidth-12))+'px';
cb.classList.add('on');
});
cm.addEventListener('click',function(e){
var b=e.target.closest('button');
if(b){$('#cl').textContent=b.getAttribute('data-c');closeCity()}
});
document.addEventListener('click',closeCity);
window.addEventListener('resize',closeCity);
function fabCheck(){
var max=document.documentElement.scrollHeight-window.innerHeight;
var y=window.pageYOffset;
fab.classList.toggle('show',max>0&&y/max>=.4);
}
window.addEventListener('scroll',function(){fabCheck();closeCity()},{passive:true});
function route(){
var h=location.hash.slice(1);
var isAbout=h==='pro-nas';
about.hidden=!isAbout;
home.hidden=isAbout;
var el=h&&!isAbout?document.getElementById(h):null;
if(el){el.scrollIntoView()}else{window.scrollTo(0,0)}
fabCheck();
}
window.addEventListener('hashchange',route);
route();
var io=new IntersectionObserver(function(en){en.forEach(function(x){
if(x.isIntersecting){x.target.classList.add('in');io.unobserve(x.target)}
})},{threshold:.15,rootMargin:'0px 0px -6% 0px'});
document.querySelectorAll('.rv,.rise').forEach(function(e){io.observe(e)});
var co=new IntersectionObserver(function(en){en.forEach(function(x){
if(!x.isIntersecting)return;
co.unobserve(x.target);
var t=x.target,n=+t.getAttribute('data-n'),p=t.getAttribute('data-p')||'',s=performance.now();
(function f(now){
var k=Math.min(1,(now-s)/1400),v=Math.round(n*(1-Math.pow(1-k,3)));
t.textContent=v+(k===1?p:'');
if(k<1)requestAnimationFrame(f);
})(s);
})},{threshold:.5});
document.querySelectorAll('[data-n]').forEach(function(e){co.observe(e)});
})();
</script>
